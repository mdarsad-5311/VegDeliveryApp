{
  "name": "VegDeliveryApp",
  "version": "1.0.0",
  "description": "FreshVeg - Farm Fresh Vegetable & Grocery Delivery Mobile App built with React Native CLI",
  "author": "mdarsad-5311 <mdarsadkgn5311@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "build:release": "npm run bundle:android && cd android && ./gradlew assembleRelease",
    "clean:android": "cd android && ./gradlew clean",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/new-app-screen": "0.88.1",
