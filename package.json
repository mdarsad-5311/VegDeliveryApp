    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "axios": "^1.21.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "^3.5.0",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "^4.8.0",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "^15.16.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "^0.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
